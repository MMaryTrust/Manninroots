# Copy to .env (never commit .env). Load with: node --env-file=.env src/server.js
# Hosted PostgreSQL connection string (Neon, Supabase Postgres, RDS, local ...).
# Leave DATABASE_URL unset to use in-process PGlite (dev/tests only, data is lost on restart).
DATABASE_URL=postgres://user:password@host:5432/mannin?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
SEED_PASSWORD=choose-a-demo-password
WEB_ORIGIN=http://localhost:5174
PORT=3001
